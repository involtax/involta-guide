# Secrets are provided by server environment / secret manager; never commit real values.
DATABASE_URL=
TEST_DATABASE_URL=
DATABASE_SCHEMA=public
SESSION_SECRET=
# Production: generate with `uv run guide hash-password` (Argon2id).
ADMIN_PASSWORD_HASH=
# Optional local-development alternative, at least 12 characters.
ADMIN_PASSWORD=
AGENT_API_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
SITE_URL=https://involta.ru/guide
BASE_PATH=/guide
COOKIE_SECURE=true
# Only explicitly trusted nginx peer IPs may supply X-Forwarded-For.
TRUSTED_PROXY_IPS=127.0.0.1
DATA_DIR=var
DAILY_AI_CALLS=1000
LEASE_SECONDS=240
MAX_JOB_ATTEMPTS=3
# Background generation: polls reuse the saved OpenAI response, never repeat POST.
GENERATION_POLL_SECONDS=10
GENERATION_WAIT_SECONDS=3600
GENERATION_PARALLEL_LIMIT=2
GENERATION_MAX_OUTPUT_TOKENS=32000
# Only for compose.local.yaml; production uses existing PostgreSQL.
POSTGRES_PASSWORD=

# Set automatically by production workflows.
RELEASE_SHA=development

# TEMPORARY: unauthenticated initial fill button on empty location pages.
# Remove/disable after the manual production test period.
TEMPORARY_PUBLIC_FILL_ENABLED=true
PUBLIC_FILL_LOGS_ENABLED=true
# TEMPORARY: destructive owner-local beta reset; pending resets remain closed when disabled.
BETA_RESET_ENABLED=true

# One normal review flow for visitors and administrators.
VOICE_ENABLED=false
# Beta: full upload responses in the widget and existing Guide audit log.
VOICE_DEBUG_ENABLED=true
VOICE_URL=http://127.0.0.1:3100
VOICE_SERVICE_SECRET=
