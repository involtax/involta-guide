# Copy to .env.local; use a long random password before starting.
ADMIN_PASSWORD=
SESSION_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
SITE_URL=http://localhost:3000

# Set true for production HTTPS. Reverse proxy must replace X-Forwarded-For.
COOKIE_SECURE=false

# PostgreSQL: generate local values with npm run setup:local.
DATABASE_URL=
POSTGRES_PASSWORD=
# Tests create temporary schemas; use a dedicated test database in production.
TEST_DATABASE_URL=
