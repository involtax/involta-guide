# Copy to .env.local; use a long random password before starting.
ADMIN_PASSWORD=
SESSION_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Full public URL, including the mount path. Local: http://localhost:3000/guide
SITE_URL=https://involta.ru/guide
# Build-time value; rebuild the image after changing it.
NEXT_PUBLIC_BASE_PATH=/guide

# Set true for production HTTPS. Reverse proxy must replace X-Forwarded-For.
COOKIE_SECURE=false

# PostgreSQL: generate local values with npm run setup:local.
DATABASE_URL=
POSTGRES_PASSWORD=
# Tests create temporary schemas; use a dedicated test database in production.
TEST_DATABASE_URL=

# Alex link: https://involta.ru/guide/?SECRET (no parameter name).
# Generate 32 random bytes; never commit the value.
ALEX_SECRET=
