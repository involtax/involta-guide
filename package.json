{
  "name": "involta-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "NODE_USE_ENV_PROXY=1 next start --hostname 0.0.0.0",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "worker": "node --use-env-proxy --env-file-if-exists=.env.local scripts/worker.mjs",
    "check": "tsc --noEmit",
    "test:e2e": "node tests/e2e.mjs",
    "format": "prettier --write app components lib scripts tests next.config.ts tsconfig.json package.json README.md"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
