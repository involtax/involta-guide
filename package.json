{
  "name": "involta-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env.local scripts/server.mjs --dev",
    "build": "next build",
    "start": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env.local scripts/server.mjs",
    "test": "node --env-file-if-exists=.env.local --test --test-isolation=none tests/*.test.mjs",
    "worker": "node --use-env-proxy --env-file-if-exists=.env.local scripts/worker.mjs",
    "check": "tsc --noEmit",
    "test:e2e": "node --env-file-if-exists=.env.local tests/e2e.mjs",
    "format": "prettier --write app components public lib scripts tests .github compose.yml next.config.ts tsconfig.json package.json README.md",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose --env-file .env.local up -d --wait db",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
