  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LocationContext": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "content_epoch": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Content Epoch"
          },
          "restaurants": {
            "items": {
              "$ref": "#/components/schemas/RestaurantContext"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Restaurants"
          },
          "recognition_dictionary": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recognition Dictionary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "content_epoch"
        ],
        "title": "LocationContext"
      },
      "LocationPurged": {
        "properties": {
          "purged": {
            "type": "boolean",
            "const": true,
            "title": "Purged"
          },
          "content_epoch": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Content Epoch"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "purged",
          "content_epoch"
        ],
        "title": "LocationPurged"
      },
      "LocationReset": {
        "properties": {
          "content_epoch": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Content Epoch"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content_epoch"
        ],
        "title": "LocationReset"
      },
      "RestaurantContext": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "phone": {
            "type": "string",
            "title": "Phone",
            "default": ""
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "openingHours": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Openinghours"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "RestaurantContext"
      },
      "SubmissionStatus": {
        "properties": {
          "reference": {
            "type": "string",
            "format": "uuid",
            "title": "Reference"
          },
          "location": {
            "$ref": "#/components/schemas/LocationContext"
          },
          "state": {
            "type": "string",
            "enum": [
              "accepted",
              "transcription",
              "analysis",
              "result_ready",
              "delivered_to_guide",
              "transcription_failed",
              "transcription_unknown",
              "analysis_failed",
              "analysis_unknown"
            ],
            "title": "State"
          },
          "run": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Run"
          },
          "transcript": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcript"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "repeat_signals": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Repeat Signals"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reference",
          "location",
          "state",
          "run",
          "transcript",
          "created_at"
        ],
        "title": "SubmissionStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
