{
  "$defs": {
    "LocationContext": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "slug": {
          "maxLength": 200,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Slug",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "content_epoch": {
          "minimum": 1,
          "title": "Content Epoch",
          "type": "integer"
        },
        "restaurants": {
          "items": {
            "$ref": "#/$defs/RestaurantContext"
          },
          "maxItems": 200,
          "title": "Restaurants",
          "type": "array"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "content_epoch"
      ],
      "title": "LocationContext",
      "type": "object"
    },
    "LocationPurged": {
      "additionalProperties": false,
      "properties": {
        "purged": {
          "const": true,
          "title": "Purged",
          "type": "boolean"
        },
        "content_epoch": {
          "minimum": 1,
          "title": "Content Epoch",
          "type": "integer"
        }
      },
      "required": [
        "purged",
        "content_epoch"
      ],
      "title": "LocationPurged",
      "type": "object"
    },
    "LocationReset": {
      "additionalProperties": false,
      "properties": {
        "content_epoch": {
          "minimum": 1,
          "title": "Content Epoch",
          "type": "integer"
        }
      },
      "required": [
        "content_epoch"
      ],
      "title": "LocationReset",
      "type": "object"
    },
    "OutboxEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "recording_received",
            "gigaam_ready",
            "transcript_ready",
            "analysis_ready",
            "processing_failed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference": {
          "format": "uuid",
          "title": "Reference",
          "type": "string"
        },
        "run": {
          "minimum": 1,
          "title": "Run",
          "type": "integer"
        },
        "metadata": {
          "$ref": "#/$defs/SubmissionMetadata"
        },
        "transcript": {
          "anyOf": [
            {
              "maxLength": 30000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript"
        },
        "analysis": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "mime": {
          "enum": [
            "audio/webm",
            "audio/ogg",
            "audio/mp4",
            "audio/wav"
          ],
          "title": "Mime",
          "type": "string"
        },
        "duration": {
          "maximum": 121,
          "minimum": 1,
          "title": "Duration",
          "type": "number"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "repeat_signals": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Repeat Signals",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "sequence",
        "kind",
        "reference",
        "run",
        "metadata",
        "sha256",
        "mime",
        "duration",
        "created_at"
      ],
      "title": "OutboxEvent",
      "type": "object"
    },
    "RestaurantContext": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "phone": {
          "default": "",
          "title": "Phone",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "openingHours": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Openinghours"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "RestaurantContext",
      "type": "object"
    },
    "SubmissionMetadata": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "location": {
          "$ref": "#/$defs/LocationContext"
        },
        "visitor": {
          "maxLength": 200,
          "minLength": 32,
          "title": "Visitor",
          "type": "string"
        },
        "idempotency_key": {
          "format": "uuid",
          "title": "Idempotency Key",
          "type": "string"
        },
        "ip": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Ip",
          "type": "string"
        },
        "user_agent": {
          "default": "",
          "maxLength": 10000,
          "title": "User Agent",
          "type": "string"
        },
        "widget_version": {
          "const": "1",
          "default": "1",
          "title": "Widget Version",
          "type": "string"
        },
        "language": {
          "default": "",
          "maxLength": 40,
          "title": "Language",
          "type": "string"
        },
        "timezone": {
          "default": "",
          "maxLength": 100,
          "title": "Timezone",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "required": [
        "location",
        "visitor",
        "idempotency_key",
        "ip",
        "correlation_id"
      ],
      "title": "SubmissionMetadata",
      "type": "object"
    },
    "SubmissionStatus": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "format": "uuid",
          "title": "Reference",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/LocationContext"
        },
        "state": {
          "enum": [
            "accepted",
            "transcription",
            "analysis",
            "result_ready",
            "delivered_to_guide",
            "transcription_failed",
            "transcription_unknown",
            "analysis_failed",
            "analysis_unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "run": {
          "minimum": 1,
          "title": "Run",
          "type": "integer"
        },
        "transcript": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transcript"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "repeat_signals": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Repeat Signals",
          "type": "object"
        }
      },
      "required": [
        "reference",
        "location",
        "state",
        "run",
        "transcript",
        "created_at"
      ],
      "title": "SubmissionStatus",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/SubmissionMetadata"
    },
    {
      "$ref": "#/$defs/SubmissionStatus"
    },
    {
      "$ref": "#/$defs/OutboxEvent"
    },
    {
      "$ref": "#/$defs/LocationReset"
    },
    {
      "$ref": "#/$defs/LocationPurged"
    }
  ]
}
