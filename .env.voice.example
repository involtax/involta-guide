# Copy to .env.voice; never commit real credentials.
# Separate database/role: never use DATABASE_URL from Guide here.
VOICE_DATABASE_URL=postgresql://voice:CHANGE_ME@voice-db:5432/voice
VOICE_SERVICE_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
OPENAI_API_KEY=
VOICE_POSTGRES_PASSWORD=CHANGE_ME
VOICE_DATA_DIR=var/voice
VOICE_TRANSCRIPTION_MODEL=gigaam
VOICE_ASR_MODELS_DIR=var/asr-models
VOICE_ASR_CPU_THREADS=2
VOICE_ASR_BETA_ENABLED=true
VOICE_ANALYSIS_MODEL=gpt-4.1
VOICE_DAILY_CALLS=100
VOICE_DAILY_BUDGET_USD=20
VOICE_PER_CALL_RESERVE_USD=2
VOICE_QUEUE_LIMIT=1000
VOICE_CONCURRENCY=2
VOICE_LEASE_SECONDS=180
VOICE_MIN_FREE_BYTES=67108864
# Local development only; must be false when using real speech.
VOICE_FAKE_PROVIDER=false
